# ==============================================================================
# Agent Control Tower - Environment Variables Configuration Template
# ==============================================================================

# Server Environment
# Set to 'production' in production deployments, 'development' locally
NODE_ENV=development
PORT=5000

# Allowed Frontend Origins for CORS & Socket.IO
# In development: http://localhost:5173
# In production: comma-separated list of production URLs, e.g. https://controltower.example.com,https://act.vercel.app
CLIENT_URL=http://localhost:5173

# Database Connection URI
# Local MongoDB: mongodb://127.0.0.1:27017/agent_control_tower
# MongoDB Atlas: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/agent_control_tower?retryWrites=true&w=majority
# Accepts MONGO_URI or MONGODB_URI
MONGO_URI=mongodb://127.0.0.1:27017/agent_control_tower

# Cryptographic Authentication & Security
# IMPORTANT: In production, generate a unique 64-character secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=supersecretjwtkey_control_tower_2026_secure
JWT_EXPIRES_IN=7d

# Governance Policy Baseline Thresholds
DEFAULT_COST_PER_1K_TOKENS=0.002
DEFAULT_TOKEN_BUDGET=50000
DEFAULT_MAX_DURATION_MS=30000
DEFAULT_REPEAT_CALL_THRESHOLD=3
