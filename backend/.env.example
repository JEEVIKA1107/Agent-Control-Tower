# ==============================================================================
# Agent Control Tower - Backend Environment Variables Configuration Template
# ==============================================================================

NODE_ENV=development
PORT=5000

# Allowed Frontend Origins for CORS & Socket.IO (comma-separated if multiple)
CLIENT_URL=http://localhost:5173

# Database Connection URI (Supports MONGO_URI or MONGODB_URI)
MONGO_URI=mongodb://127.0.0.1:27017/agent_control_tower

# Cryptographic Authentication & Security
# Generate secure production secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=supersecretjwtkey_control_tower_2026_secure
JWT_EXPIRES_IN=7d

# Governance Baseline Defaults
DEFAULT_COST_PER_1K_TOKENS=0.002
DEFAULT_TOKEN_BUDGET=50000
DEFAULT_MAX_DURATION_MS=30000
DEFAULT_REPEAT_CALL_THRESHOLD=3
