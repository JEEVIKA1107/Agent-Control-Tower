# Agent Control Tower - Frontend Environment Variables

# Base URL for API requests.
# For single-domain or proxy deployments, leave as '/api'
# For decoupled deployments (e.g., Frontend on Vercel, Backend on Render),
# set to your deployed backend API URL, e.g.: https://agent-control-tower-api.onrender.com/api
VITE_API_URL=/api

# WebSocket Server URL for real-time telemetry and alerts.
# For decoupled deployments, set to backend host, e.g.: https://agent-control-tower-api.onrender.com
# If omitted, defaults to VITE_API_URL host or current origin.
VITE_SOCKET_URL=http://localhost:5000
